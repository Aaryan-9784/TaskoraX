PORT=5000
NODE_ENV=development

# MongoDB URI (Replace with your Atlas URI)
MONGODB_URI=mongodb://localhost:27017/taskorax

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_please_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
