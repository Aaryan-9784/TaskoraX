# ==============================================================================
# TaskoraX - Master .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.*

# Build Outputs
dist/
build/
out/
.next/
.nuxt/
coverage/

# Frontend (Vite/React) specific
frontend/dist/
frontend/build/
frontend/node_modules/

# Backend (Node/Express) specific
backend/node_modules/

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
frontend/.env
backend/.env

# Caches
.cache/
.npm/
.eslintcache
.vite/

# OS/System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Tt]humbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.vim
*.sublime-workspace
*.sublime-project
