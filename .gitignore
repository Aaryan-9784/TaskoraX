# ==============================================================================
# TaskoraX - Master .gitignore
# ==============================================================================
# Organized rules to prevent committing dependencies, secrets, build artifacts,
# temporary caches, logs, and system/editor-specific files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
.pnp/
.pnp.*

# ------------------------------------------------------------------------------
# 2. Production Build & Output Directories
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
coverage/
.nyc_output/
*.lcov
frontend/dist/
frontend/build/

# ------------------------------------------------------------------------------
# 3. Environment & Sensitive Configuration Files
# ------------------------------------------------------------------------------
# Ignore all actual .env files containing secret keys and credentials
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env

# Exception: Always track example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 4. Logs & Debugging Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Caches & Temporary Storage
# ------------------------------------------------------------------------------
.cache/
.npm/
.eslintcache
.stylelintcache
.vite/
.rollup.cache/
.parcel-cache/
.temp/
.tmp/
tmp/
temp/

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
[Tt]humbs.db
[Tt]humbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. IDE & Editor Workspaces
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Visual Studio / Windows tools
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.vim
*.bak

# AI & Local Assistant cache
.gemini/
.agents/
